# Copy to .env (gitignored) and fill in real values, or export these directly in your shell.
# packages/core/model_client.py loads this file itself (python-dotenv) the moment it's
# imported, so anything that builds a ModelClient() without explicit constructor args
# (apps/chat_console/app.py, etc.) picks these up automatically — no wrapper script needed.
# Values already present in the shell environment always take precedence over this file.

# anthropic | openai-compatible | mock
MODEL_PROVIDER=

# Required except for mock.
MODEL_API_KEY=

# Required except for mock.
MODEL_NAME=

# Overrides the built-in preset base URL. Required for openai-compatible when pointing at a
# non-OpenAI endpoint (e.g. DeepSeek: https://api.deepseek.com/v1).
MODEL_BASE_URL=

# Request timeout in seconds. Defaults to 60 if unset.
MODEL_TIMEOUT=

# Sampling temperature. Defaults to 0.7 if unset. Some models only accept a fixed value
# (e.g. certain Kimi/Moonshot models reject anything but 1 with "invalid temperature").
MODEL_TEMPERATURE=
