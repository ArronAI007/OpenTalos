# Copy to .env (gitignored) and fill in real values, or export these directly in your shell.
# Read by packages/core/model_client.py — every ModelClient() built without explicit
# constructor args (apps/chat_console/app.py, the skill service, etc.) picks these up.
# Nothing in this repo auto-loads .env, so run with `uv run --env-file .env ...` (or export
# the values yourself) — plain `uv run ...` will not see them.

# anthropic | openai-compatible | mock
MODEL_PROVIDER=

# Required except for mock.
MODEL_API_KEY=

# Required except for mock.
MODEL_NAME=

# Overrides the built-in preset base URL. Required for openai-compatible when pointing at a
# non-OpenAI endpoint (e.g. DeepSeek: https://api.deepseek.com/v1).
MODEL_BASE_URL=

# Request timeout in seconds. Defaults to 60 if unset.
MODEL_TIMEOUT=
