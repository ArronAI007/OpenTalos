# Copy to .env (gitignored) and fill in real values, or export these directly in your shell.
# packages/core/model.py loads this file itself (python-dotenv) the moment it's imported, so
# anything that builds a ModelClient() without explicit constructor args
# (apps/chat_console/app.py, etc.) picks these up automatically — no wrapper script needed.
# Values already present in the shell environment always take precedence over this file.

# anthropic | openai-compatible | mock
MODEL_PROVIDER=

# Required except for mock.
MODEL_API_KEY=

# Required except for mock.
MODEL_NAME=

# Overrides the built-in preset base URL. Required for openai-compatible when pointing at a
# non-OpenAI endpoint (e.g. DeepSeek: https://api.deepseek.com/v1).
MODEL_BASE_URL=

# Request timeout in seconds. Defaults to 60 if unset.
MODEL_TIMEOUT=

# Sampling temperature. Leave empty to omit it from the request entirely and let the provider
# use its own default — that is the safe setting for models that only accept a fixed value
# (o-series, kimi-k3, ... they reject anything else with "invalid temperature"). Set a number
# only when you actually want to pin the sampling temperature.
MODEL_TEMPERATURE=

# Reasoning effort for always-on thinking models (kimi-k3: low | high | max). Leave empty to
# omit it from the request and let the provider use its own default. Lower effort = shorter
# hidden chain-of-thought = faster first visible token, at some cost to deep reasoning quality.
MODEL_REASONING_EFFORT=

# Optional price table (USD per 1M tokens) so the trace HTML and the reply footer can show cost.
# Format: {"<model>": {"input": <price>, "output": <price>}}. There are NO built-in prices —
# when unset, cost is simply not shown (never a fake $0).
# MODEL_PRICES=

# Retry on transient model errors (429, 5xx, connection/timeout). Exponential backoff with
# full jitter, honouring a Retry-After header when the provider sends one. Set MODEL_MAX_RETRIES=0
# to disable. Streaming retries only before anything was streamed to the caller.
# MODEL_MAX_RETRIES=3
# MODEL_RETRY_BASE_SECONDS=0.5
# MODEL_RETRY_MAX_SECONDS=8

# Where the chat API (apps/api) reaches the skill service.
# The service itself is started together with the API by ./scripts/start.sh.
SKILL_SERVICE_URL=http://localhost:8321

# Chat API address the web frontend (apps/web) calls. ./scripts/start.sh injects this
# automatically; set it yourself only when running the web frontend by hand.
NEXT_PUBLIC_API_URL=http://localhost:8400
# CORS_ORIGINS=http://localhost:3000  # 逗号分隔；默认仅 http://localhost:3000

# Tavily API key for the web_search / web_extractor tools (packages/websearch). Leave empty
# to disable both tools — they are optional, unlike MODEL_API_KEY. Get a key at
# https://app.tavily.com.
TAVILY_API_KEY=

# Tool reliability safety net (apps/api). Each tool has its own shorter timeout; these bound a
# hung tool and trip a per-tool circuit breaker so a broken tool stops being retried. The
# breaker is process-wide (shared across tasks). Empty falls back to the default shown.
# TOOL_TIMEOUT_SECONDS=120           # 0 disables the registry-level timeout
# TOOL_CIRCUIT_FAILURE_THRESHOLD=3   # 0 disables the circuit breaker
# TOOL_CIRCUIT_RECOVERY_SECONDS=300

# How long a side-effecting tool call (run_skill_script, MCP tools) waits for the user's
# approval before it is denied. The frontend shows an approve/deny card meanwhile.
# APPROVAL_TIMEOUT_SECONDS=300

# Long-term memory (cross-session). When enabled, each finished turn triggers one extra model call
# deciding whether it holds a durable user fact worth remembering, and relevant memories are
# injected into later prompts. Off by default to avoid that extra call.
# MEMORY_ENABLED=0

# Per-turn token budget: once a turn's cumulative tokens exceed this, the turn is aborted.
# Leave empty for no limit.
# TASK_TOKEN_BUDGET=
