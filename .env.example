# Copy to .env (gitignored) and fill in real values.
# Loaded by both apps/worker and apps/api at startup (repo-root .env) — keeping them in one
# file avoids the two processes silently ending up on different providers/models (see README).
# Values already present in the shell environment always take precedence over this file.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres

# apps/api only. Bootstrap secret for /admin/* routes.
ADMIN_API_KEY=

# apps/api only. Defaults to 3001.
PORT=

# anthropic | openai-compatible | ollama | dashscope | doubao | kimi | minimax | mock
MODEL_PROVIDER=

# Required except for ollama/mock.
MODEL_API_KEY=

# Required except for mock.
MODEL_NAME=

# Overrides the built-in preset base URL. Required for ollama. Required for openai-compatible
# when pointing at a non-OpenAI endpoint (e.g. DeepSeek: https://api.deepseek.com/v1).
MODEL_BASE_URL=
